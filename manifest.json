{
  "manifest_version": 3,
  "name": "KosLess",
  "short_name": "KosLess",
  "version": "0.6.7",
  "description": "Unofficial Kosmora helper: readable pack summaries with sale prices, a pulls panel with bulk sell, sell-page price helpers, quest badges, and hotkeys for packs, albums and navigation.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://kosmora.io/*"
  ],
  "action": {
    "default_title": "KosLess settings",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "bg.js",
    "scripts": [
      "bg.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://kosmora.io/*"
      ],
      "js": [
        "kosmore-import.js",
        "settings.js",
        "panel.js",
        "content.js",
        "layout.js",
        "prices.js",
        "keys.js",
        "sell.js"
      ],
      "css": [
        "style.css",
        "layout.css",
        "keys.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kosless@extension",
      "strict_min_version": "128.0"
    }
  }
}
